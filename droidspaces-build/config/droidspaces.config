# GKI 5.15: use only with the task_struct padding 6/7/8 SYSVIPC patch.
# The full baseline is the config extracted from this running device.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# Recommended by Droidspaces' GKI guide.
CONFIG_USER_NS=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_MACVLAN=y
# The guide's NETFILTER_XT_TARGET_REJECT symbol does not exist in this 5.15 tree.
# Its IPv4/IPv6 equivalents already exist in the device baseline.
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# CFS_BANDWIDTH and CGROUP_PIDS deliberately retain their baseline values.
# Enabling either requires rebuilding the complete vendor module set.
